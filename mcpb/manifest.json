{
  "manifest_version": "0.4",
  "name": "telegram-ai-cli-mcp",
  "display_name": "Telegram AI CLI",
  "description": "Read a personal Telegram account and prepare changes for a person to approve.",
  "long_description": "Reads chats, search, members and devices on a personal Telegram account, and prepares sends, moderation and settings changes as plans. Sign in first with `tg-ai account login` in a terminal; the session is stored under ~/.local/state/telegram-ai-cli-mcp/ and this extension cannot prompt for a login code. The server sends nothing by itself: a person reviews the plan and applies it with `tg-ai plan apply`. Profile is readonly (the default; reads only) or plan (reads, plus preparing plans).",
  "author": {
    "name": "stufently"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stufently/telegram-ai-cli-mcp"
  },
  "homepage": "https://github.com/stufently/telegram-ai-cli-mcp",
  "support": "https://github.com/stufently/telegram-ai-cli-mcp/issues",
  "license": "MIT",
  "keywords": ["telegram", "mcp", "mtproto", "userbot"],
  "privacy_policies": ["https://telegram.org/privacy"],
  "compatibility": {
    "platforms": ["darwin", "linux"],
    "runtimes": {
      "python": ">=3.12"
    }
  },
  "server": {
    "type": "uv",
    "entry_point": "launch.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${__dirname}", "launch.py"],
      "env": {
        "TGAI_PROFILE": "${user_config.profile}"
      }
    }
  },
  "user_config": {
    "profile": {
      "type": "string",
      "title": "Profile",
      "description": "readonly or plan",
      "default": "readonly"
    }
  },
  "tools": [
    {"name": "telegram_archive_forget", "description": "Erase one chat from the local archive."},
    {"name": "telegram_archive_search", "description": "Search the local archive offline."},
    {"name": "telegram_archive_status", "description": "Show what the local archive holds."},
    {"name": "telegram_archive_sync", "description": "Copy one chat into the local archive."},
    {"name": "telegram_chat_members", "description": "List members of a group or channel."},
    {"name": "telegram_chat_read", "description": "Read one chat's history."},
    {"name": "telegram_chat_topics", "description": "List forum topics."},
    {"name": "telegram_chats", "description": "List dialogs."},
    {"name": "telegram_drafts", "description": "List unsent drafts."},
    {"name": "telegram_fleet", "description": "List configured accounts."},
    {"name": "telegram_folders", "description": "List chat folders."},
    {"name": "telegram_inbox", "description": "Show chats waiting for a reply."},
    {"name": "telegram_media_fetch", "description": "Download one attachment."},
    {"name": "telegram_media_transcribe", "description": "Transcribe one voice message locally."},
    {"name": "telegram_mentions", "description": "List unread mentions and reactions."},
    {"name": "telegram_message_reactions", "description": "Read reaction counts on one message."},
    {"name": "telegram_plan_archive_chat", "description": "Plan archiving a chat."},
    {"name": "telegram_plan_ban_user", "description": "Plan banning one member."},
    {"name": "telegram_plan_block_user", "description": "Plan blocking one person."},
    {"name": "telegram_plan_create_group", "description": "Plan creating a supergroup or channel."},
    {"name": "telegram_plan_delete_message", "description": "Plan deleting messages."},
    {"name": "telegram_plan_demote_admin", "description": "Plan removing admin rights."},
    {"name": "telegram_plan_edit_message", "description": "Plan editing a message."},
    {"name": "telegram_plan_folder_add", "description": "Plan putting a chat into a folder."},
    {"name": "telegram_plan_forward_message", "description": "Plan forwarding messages."},
    {"name": "telegram_plan_invite_user", "description": "Plan inviting one user."},
    {"name": "telegram_plan_join_chat", "description": "Plan joining a chat."},
    {"name": "telegram_plan_kick_user", "description": "Plan removing one member."},
    {"name": "telegram_plan_leave_chat", "description": "Plan leaving a chat."},
    {"name": "telegram_plan_mark_read", "description": "Plan marking a chat read."},
    {"name": "telegram_plan_mute_chat", "description": "Plan muting a chat."},
    {"name": "telegram_plan_pin_message", "description": "Plan pinning a message."},
    {"name": "telegram_plan_promote_admin", "description": "Plan granting admin rights."},
    {"name": "telegram_plan_react_message", "description": "Plan reacting to a message."},
    {"name": "telegram_plan_reply_message", "description": "Plan replying to a message."},
    {"name": "telegram_plan_restrict_user", "description": "Plan restricting one member."},
    {"name": "telegram_plan_schedule_message", "description": "Plan a message for later."},
    {"name": "telegram_plan_send_file", "description": "Plan sending one local file."},
    {"name": "telegram_plan_send_message", "description": "Plan sending a new message."},
    {"name": "telegram_plan_set_chat_about", "description": "Plan changing a chat description."},
    {"name": "telegram_plan_set_chat_photo", "description": "Plan replacing a chat photo."},
    {"name": "telegram_plan_set_chat_title", "description": "Plan renaming a chat."},
    {"name": "telegram_plan_set_profile", "description": "Plan changing this account's profile."},
    {"name": "telegram_plan_unban_user", "description": "Plan lifting a ban."},
    {"name": "telegram_plan_unblock_user", "description": "Plan unblocking one person."},
    {"name": "telegram_plan_unpin_message", "description": "Plan unpinning a message."},
    {"name": "telegram_plan_unreact_message", "description": "Plan removing a reaction."},
    {"name": "telegram_scheduled", "description": "List messages queued for later."},
    {"name": "telegram_search", "description": "Search messages."},
    {"name": "telegram_sessions", "description": "List signed-in devices."},
    {"name": "telegram_watch", "description": "Wait for the next message."},
    {"name": "telegram_whois", "description": "Resolve a username, id or invite."}
  ]
}
